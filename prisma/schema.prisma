generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Le statut est une String contrainte côté application aux valeurs de
// lib/status.ts (ApplicationStatus).
model Application {
  id          String    @id @default(cuid())
  company     String
  position    String
  url         String?
  location    String?
  sector      String?
  salaryRange String?
  status      String    @default("WISHLIST")
  appliedDate DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Offres trouvées automatiquement par le robot de recherche (scripts/scrape.ts).
// status: NEW | DISMISSED | CONVERTED (voir lib/suggestion-status.ts)
model JobListing {
  id              String    @id @default(cuid())
  source          String
  sourceUrl       String    @unique
  title           String
  company         String?
  location        String?
  matchedKeywords String?
  status          String    @default("NEW")
  publishedAt     DateTime?
  foundAt         DateTime  @default(now())
}
